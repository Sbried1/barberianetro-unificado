# =====================================================================
# Variables de entorno de Netro Barbería.
# Copiá este archivo como ".env" y completá los valores. El .env NUNCA se
# sube a GitHub (está en .gitignore).
# =====================================================================

# --- Conexión de PHP a MySQL (config/conexion.php) ---
# Con Docker, DB_HOST es "mysql" (nombre del servicio en docker-compose.yml).
# Con XAMPP u otro MySQL local, normalmente "localhost".
DB_NAME=barberia_db
DB_HOST=mysql
DB_USER=barberia
DB_PASSWORD=

# --- Contenedor MySQL (docker-compose.yml) ---
# Con Docker, MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD deben coincidir
# con DB_NAME / DB_USER / DB_PASSWORD.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=barberia_db
MYSQL_USER=barberia
MYSQL_PASSWORD=

# --- Correo para "Olvidé mi contraseña" (opcional) ---
SMTP_USER=
SMTP_PASS=
APP_URL=http://localhost:8080
